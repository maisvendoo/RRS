# Служебные каталоги, не нужные для сборки в контейнере
.git
.gitignore
.github

# Результаты предыдущих сборок (могут занимать гигабайты)
build
build-*
bin
lib
modules
plugins
cmake-build-*
dist
.deps

# Маршруты в образ не входят: в dist/routes/ их копирует скрипт сборки.
# Без исключения каждый docker build тащил бы ~750 МБ контекста.
routes

# Редакторы и локальный мусор
.vscode
.idea
*.swp
.DS_Store

# Документация в образ не попадает (PDF и прочее)
docs