<?xml version="1.0" encoding="UTF-8"?>
<!--
    Пример конфига анимации частиц (дым/выхлоп) для тепловоза.

    Параметры настраиваются в секции <ParticlesAnimation>.
    Позиция эмиттера берётся из 3D-ноды модели (Empty в Blender),
    имя ноды = имя файла конфига (без .xml).

    Сигнал (SignalID) задаёт интенсивность эмиссии.
    Опциональный SpeedSignalID задаёт снос частиц пропорционально скорости ПЕ.
-->
<Config>
    <ParticlesAnimation>
        <!-- Индекс сигнала в analogSignal, управляющий эмиссией (0..1) -->
        <SignalID>500</SignalID>

        <!-- Опционально: индекс сигнала скорости (км/ч) для сноса частиц назад -->
        <SpeedSignalID>38</SpeedSignalID>

        <!-- Путь к текстуре (относительно каталога данных) -->
        <Texture>models/default-objects/textures/smoke.png</Texture>

        <!-- Базовый размер частицы, м -->
        <Size>0.6</Size>

        <!-- Вариация размера (0..1) — разброс относительного базового -->
        <SizeVariation>0.2</SizeVariation>

        <!-- Темп эмиссии, частиц/сек при максимальном сигнале (1.0) -->
        <SpawnRate>25.0</SpawnRate>

        <!-- Время жизни частицы, сек -->
        <LifeTime>2.5</LifeTime>

        <!-- Начальная скорость выброса, м/с -->
        <Speed>1.5</Speed>

        <!-- Вариация скорости (0..1) -->
        <SpeedVariation>0.4</SpeedVariation>

        <!-- Гравитация, м/с² (обычно 0.2..0.5 для дыма) -->
        <Gravity>0.2</Gravity>

        <!-- Разброс направления выброса, рад (~0.3..0.5) -->
        <Spread>0.3</Spread>

        <!-- Замедление частицы от сопротивления воздуха (0.95..0.99) -->
        <Drag>0.97</Drag>

        <!--
            Опционально: FixedSignal и Duration — как в других ProcAnimation.
            FixedSignal = 0.5 — эмиссия 50% без внешнего сигнала.
        -->
    </ParticlesAnimation>
</Config>