<?xml version="1.0" encoding="UTF-8"?>
<Config>
	<Device>
		<!-- Ограничение тока якоря ТЭД -->
		<Imax>500.0</Imax>
		<!-- Падение тока якоря от уставки, для набора следующей позиции -->
		<DeltaI>50.0</DeltaI>
		<!-- Конструкционная скорость -->
		<V_constr>100.0</V_constr>
		<!-- Пропорциональный коэффициент регулятора скорости -->
		<Kp>0.32</Kp>
		<!-- Интегральный коэффициент регулятора скорости -->
		<Ki>0.0</Ki>
		<!-- Ускорение кривой снижения скорости -->
		<BrakeAccel>0.1</BrakeAccel>
		<!-- Дистанция упреждения на КЖ -->
		<LeadDistance_RY>20.0</LeadDistance_RY>
		<!-- Дистанция упреждения на Ж -->
		<LeadDistance_Y>0.0</LeadDistance_Y>
		<!-- Ограничение скорости при КЖ -->
		<SpeedLimit_RY>60.0</SpeedLimit_RY>
		<!-- Скорость движения для запрета отпуска -->
		<SpeedDisableRelease>5.0</SpeedDisableRelease>

		<!-- Первышение скорости при торможении ЭПТ -->
		<dVminusEPB>0.5</dVminusEPB>
		<!-- Снижение скорости при отпуске ЭПТ -->
		<dVplusEPB>3.0</dVplusEPB>		
		<!-- Превышение скосрости при торможении ПТ -->
		<dVminusPB>0.5</dVminusPB>
		<!-- Снижение скорости при отпуске ПТ -->		
		<dVplusPB>3.0</dVplusPB>
		<!-- Завышение при отпуске ЭПТ -->
		<dpEPB_over>0.02</dpEPB_over>
		<!-- Завышение при отпуске ПТ -->
		<dpPB_over>0.04</dpPB_over>
		<!-- Глубина разрядки ТМ при первой ступени -->
		<dpFirstStep>0.06</dpFirstStep>
		<!-- Величина последующих ступеней -->
		<dpOtherStep>0.02</dpOtherStep>
		<!-- Время в перекрыше для оценки эффективности ступени -->
		<HoldTimeout>10.0</HoldTimeout>
		<!-- Минимальная ступень ЭПТ -->
		<pBC_EPB>0.1</pBC_EPB>
	</Device>
</Config>