<?xml version="1.0" encoding="UTF-8"?>
<Config>
	<Device>
		<Name>BPepb</Name>
		<Order>5</Order>

		<!-- Количество линий управления ЭПТ -->
		<LinesNum>2</LinesNum>

		<!-- Признак использования рукава на локомотиве: 0 - вагон, 1 - локомотив -->
		<!-- На локомотивах у рукавов, закреплённых на подвесе, линии ЭПТ размыкаются -->
		<IsHoseAtLoco>0</IsHoseAtLoco>


		<!-- Коэффициент громкости озвучки к потоку опорожнения магистрали через рукав -->
		<K_sound>1.5</K_sound>


		<!-- Точка изгиба в начале рукава, в локальных координатах подвижной единицы (считая что рукав спереди), м -->
		<RootPosition>-0.3 12.17 0.8</RootPosition>

		<!-- Длина средней части рукава (от точки изгиба в начале -->
		<!-- до точки изгиба перед соединительной головкой), м -->
		<MiddleLength>0.435</MiddleLength>

		<!-- Длина жёсткого окончания рукава с соединительной головкой, м -->
		<HeadLength>0.157</HeadLength>


		<!-- Существующее конструктивное отклонение рукава от продольной оси -->
		<!-- (<0 - повёрнут влево, >0 - повёрнут вправо), градусы -->
		<!-- Для классического концевого крана с отростком под 45 градусов -->
		<!-- и поворота по оси трубы на 30 градусов получится 26.565, на 60 градусов 40.894 -->
		<ExistingSideAngle>26.565</ExistingSideAngle>

		<!-- Отклонение рукава от продольной оси в свободном состоянии, градусы -->
		<FreeSideAngle>26.565</FreeSideAngle>

		<!-- Отклонение рукава от продольной оси в закреплённом на подвесе состоянии, градусы -->
		<FixedSideAngle>8.0</FixedSideAngle>

		<!-- Несовпадение поверхности смыкания стандартной соединительной головки с осью рукава, -->
		<!-- требующее развести их влево на один сантиметр, м -->
		<SideGap>-0.01</SideGap>


		<!-- Существующее конструктивное свешивание рукава вниз от продольной оси, градусы -->
		<!-- Для классического концевого крана с отростком под 45 градусов -->
		<!-- и поворота по оси трубы на 30 градусов получится -37.761, на 60 градусов -20.704 -->
		<ExistingDownAngle>-37.761</ExistingDownAngle>

		<!-- Свешивание рукава вниз от продольной оси в свободном состоянии, градусы -->
		<FreeDownAngle>-75.0</FreeDownAngle>

		<!-- Свешивание рукава вниз от продольной оси в закреплённом на подвесе состоянии, градусы -->
		<FixedDownAngle>-94.891</FixedDownAngle>


		<!-- Существующий конструктивный изгиб вверх соединительной головки рукава, градусы -->
		<ExistingHeadUpAngle>24.0</ExistingHeadUpAngle>

		<!-- Изгиб рукава вверх перед соединительной головкой в свободном состоянии, градусы -->
		<FreeHeadUpAngle>12.0</FreeHeadUpAngle>

		<!-- Изгиб рукава вверх перед соединительной головкой в закреплённом на подвесе состоянии, градусы -->
		<FixedHeadUpAngle>-33.13</FixedHeadUpAngle>

		<!-- Изгиб рукава вверх перед соединительной головкой в состоянии готовности к соединению, градусы -->
		<ReadyToConnectHeadUpAngle>36.0</ReadyToConnectHeadUpAngle>


		<!-- Коэффициент к скорости поворотов рукава -->
		<AngleOmega>8.0</AngleOmega>

		<!-- Коэффициент к скорости колебаний рукава в свободном состоянии -->
		<FreeAngleOmega>8.0</FreeAngleOmega>

		<!-- Коэффициент затухания колебаний рукава в свободном состоянии -->
		<FreeAngleBeta>1.0</FreeAngleBeta>
	</Device>
</Config>