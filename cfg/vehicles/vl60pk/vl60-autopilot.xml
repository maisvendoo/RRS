<?xml version="1.0" encoding="UTF-8"?>
<Config>
	<Device>
		<!-- Ограничение тока якоря ТЭД -->
		<Imax>500.0</Imax>
		<!-- Падение тока якоря от уставки, для набора следующей позиции -->
		<DeltaI>50.0</DeltaI>
		<!-- Конструкционная скорость -->
		<V_constr>110.0</V_constr>
		<!-- Пропорциональный коэффициент регулятора скорости -->
		<Kp>0.32</Kp>
		<!-- Интегральный коэффициент регулятора скорости -->
		<Ki>0.0</Ki>
		<!-- Ускорение кривой снижения скорости -->
		<BrakeAccel>0.1</BrakeAccel>
		<!-- Дистанция упреждения на КЖ -->
		<LeadDistance_RY>10.0</LeadDistance_RY>
		<!-- Дистанция упреждения на Ж -->
		<LeadDistance_Y>0.0</LeadDistance_Y>
		<!-- Ограничение скорости при КЖ -->
		<SpeedLimit_RY>60.0</SpeedLimit_RY>
		<!-- Скорость движения для запрета отпуска -->
		<SpeedDisableRelease>5.0</SpeedDisableRelease>
	</Device>
</Config>