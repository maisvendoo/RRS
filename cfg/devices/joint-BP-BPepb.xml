<?xml version="1.0" encoding="UTF-8"?>
<Config>
	<Joint>
		<ModuleName>joint-pneumo-hose-epb</ModuleName>

		<!-- Начальное состояние соединения рукавов: 0 - разъединены, 1 - соединены -->
		<initConnectionState>1</initConnectionState>

		<!-- Небольшой запас длины до разъединения рукавов, на случай неудачного вписывания в кривые -->
		<LengthReserve>0.6</LengthReserve>
	</Joint>
</Config>