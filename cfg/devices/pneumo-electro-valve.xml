<?xml version="1.0" encoding="UTF-8"?>
<Config>
	<Device>
		<Order>2</Order>
		<SubStepNum>1</SubStepNum>
		<Solver>euler</Solver>

		<!-- Режим работы вентиля: 1 - нормально закрыт, при подаче напряжения открыт; 0 - нормально открыт, при подаче напряжения закрыт -->
		<Mode>1</Mode>

		<!-- Сопротивление катушки электромагнитного пневматического вентиля, Ом -->
		<R>170.0</R>

		<!-- Постоянная времени обмотки, с -->
		<T>0.1</T>

		<!-- Максимальный уровень отключения (0.0 - 1.0) -->
		<level_off>0.6</level_off>
		<!-- Минимальный уровень включения (0.0 - 1.0) -->
		<level_on>0.7</level_on>

		<!-- Условный объём труб между вентилем и оборудованием, м^3 -->
		<Vc>0.001</Vc>

		<!-- Коэффициент выпуска воздуха из оборудования через атмосферное отверстие при отключенном вентиле -->
		<Katm_device>0.0</Katm_device>

		<!-- Коэффициент выпуска воздуха из магистрали через атмосферное отверстие при отключенном вентиле -->
		<Katm_pipe>0.0</Katm_pipe>

		<!-- Коэффициент громкости озвучки к потоку выпуска воздуха через атмосферное отверстие -->
		<Ksound>0.0</Ksound>
	</Device>
</Config>