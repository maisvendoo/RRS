<?xml version="1.0" encoding="UTF-8"?>
<Config>
	<Device>
		<Order>3</Order>
		<SubStepNum>1</SubStepNum>
		<Solver>euler</Solver>

		<!-- Объём рабочих камер переключательного клапана -->
		<V1>1e-3</V1>
		<V2>1e-3</V2>

		<!-- Коэффициент перетока к выходу из рабочей камеры со стороны, куда открыт клапан -->
		<K1>5e-2</K1>

		<!-- Коэффициент к скорости переключения -->
		<A1>100.0</A1>

		<!-- Игнорировать условный объём камеры со стороны, куда открыт клапан, напрямую передавая поток и давление в смежное оборудование без задержек -->
		<IgnoreVolume1>1</IgnoreVolume1>
		<IgnoreVolume2>1</IgnoreVolume2>

	</Device>
</Config>