<?xml version="1.0" encoding="UTF-8"?>
<Config>
	<Device>
		<Order>2</Order>
		<SubStepNum>1</SubStepNum>
		<Solver>euler</Solver>

		<!-- Начальное положение комбинированного крана -->
		<!-- -1 - положение двойной тяги, 0 - поездное, 1 - экстренное торможение -->
		<CombineCranePos>-1</CombineCranePos>

		<!-- Время переключения комбинированного крана, с -->
		<SwitchTime>0.2</SwitchTime>

		<!-- Условный объём труб между комбинированным краном и оборудованием за ним -->
		<V0>1e-3</V0>

		<!-- Коэффициент потока - разрядки ТМ при экстренном торможении -->
		<K_emergency>0.1</K_emergency>

		<!-- Коэффициент громкости озвучки к потоку разрядки ТМ комбинированным краном -->
		<K_sound>3.0</K_sound>

	</Device>
</Config>