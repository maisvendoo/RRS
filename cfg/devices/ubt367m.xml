<?xml version="1.0" encoding="UTF-8"?>
<Config>
	<Device>
		<Order>5</Order>
		<SubStepNum>1</SubStepNum>
		<Solver>euler</Solver>

		<!-- Начальное положение комбинированного крана -->
		<!-- -1 - положение двойной тяги, 0 - поездное, 1 - экстренное торможение -->
		<CombineCranePos>-1</CombineCranePos>

		<!-- Начальное состояние блокировки тормозов -->
		<!-- 0 - блокировка выключена, 1 - блокировка включена -->
		<BrakeLockState>0</BrakeLockState>

		<!-- Время переключения комбинированного крана и блокировки, с -->
		<SwitchTime>0.2</SwitchTime>

		<!-- Условный объём труб между блокировкой и оборудованием за ним -->
		<V0>1e-3</V0>

		<!-- Коэффициент потока - разрядки ТМ при экстренном торможении комбинированным краном -->
		<K_emergency>0.1</K_emergency>

		<!-- Коэффициент громкости озвучки к потоку разрядки ТМ комбинированным краном -->
		<K_sound>3.0</K_sound>

		<!-- Давление в тормозной магистрали, блокирующее рукоятку устройства -->
		<p_lock>0.1</p_lock>

	</Device>
</Config>