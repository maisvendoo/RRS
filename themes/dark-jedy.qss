QWidget {
	background-color: #404040;
	color: #ffffff;
}

QPushButton {
	background-color: #00aa00;
}

QPushButton::pressed {
	background-color: #ffb140;
}

QPushButton::disabled {
	background-color: #606060;
}

QListWidget {
	background-color: #606060;
}

QListWidget::item:selected {
	background-color: #ffb140;
	color: #000000;
}

QPlainTextEdit {
	background-color: #606060;
}

QLineEdit {
	background-color: #606060;
}

QSpinBox {
	background-color: #606060;
}

QDoubleSpinBox {
	background-color: #606060;
}

QTabBar::tab:selected {
	background: #ffb140;
}

QTabBar::tab:!selected {
	background: #606060;
}

QToolBox::tab {
	background: #606060;
}

QTabWidget::pane { 
	border: 0; 
}

QComboBox {
	background-color: #606060;
}

QDateTimeEdit::disabled {
	color: #888888;
}